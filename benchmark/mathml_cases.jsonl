{"id": "mass-energy", "mathml": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>E</mi><mo>=</mo><mi>m</mi><msup><mi>c</mi><mn>2</mn></msup></math>", "expected_latex": "E=m{c}^{2}", "note": "superscript on a single letter"}
{"id": "invisible-times", "mathml": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>&#x2062;</mo><mi>&#x3c0;</mi><mo>&#x2062;</mo><mi>m</mi><msup><mi>k</mi><mn>2</mn></msup></math>", "expected_latex": "2\\pi m{k}^{2}", "note": "U+2062 must vanish, not become an operator"}
{"id": "function-application", "mathml": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>sin</mi><mo>&#x2061;</mo><mfenced><mi>x</mi></mfenced></math>", "expected_latex": "\\mathrm{sin}(x)", "note": "U+2061 is function application; sin(x) is not sin*(x)"}
{"id": "root-of-fraction", "mathml": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#x3c9;</mi><mo>=</mo><msqrt><mfrac><mi>k</mi><mi>m</mi></mfrac></msqrt></math>", "expected_latex": "\\omega=\\sqrt{\\frac{k}{m}}", "note": "square root wrapping a fraction"}
{"id": "subscript-superscript", "mathml": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>x</mi><mi>j</mi><mn>2</mn></msubsup></math>", "expected_latex": "{x}_{i}^{2}+{x}_{j}^{2}", "note": "msubsup keeps both scripts on the same base"}
{"id": "piecewise", "mathml": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mo>(</mo><mi>x</mi><mo>)</mo><mo>=</mo><mfenced open='{' close=''><mtable><mtr><mtd><mi>x</mi></mtd><mtd><mi>x</mi><mo>&gt;</mo><mn>0</mn></mtd></mtr><mtr><mtd><mo>-</mo><mi>x</mi></mtd><mtd><mi>x</mi><mo>&#x2264;</mo><mn>0</mn></mtd></mtr></mtable></mfenced></math>", "expected_latex": "f(x)=\\begin{cases}x & x>0 \\\\ -x & x\\le 0\\end{cases}", "note": "braced table becomes cases; rows are two columns"}
{"id": "uppercase-greek", "mathml": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#x398;</mi><mo>=</mo><mfrac><mrow><mi>h</mi><msub><mi>&#x3bd;</mi><mi>D</mi></msub></mrow><msub><mi>k</mi><mi>B</mi></msub></mfrac></math>", "expected_latex": "\\Theta=\\frac{h{\\nu}_{D}}{{k}_{B}}", "note": "uppercase Greek and two subscripted factors"}
{"id": "alttext-only", "mathml": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"a + b\"><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></math>", "expected_latex": "a+b", "note": "when the publisher gives alttext LaTeX, prefer it over reconstruction"}
