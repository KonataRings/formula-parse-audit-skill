{"id": "debye-lowT-heat-capacity", "latex": "C_p=\\frac{12}{5}\\pi^4 N k_B (\\frac{T}{\\Theta})^3", "independent_expr": "(12/5)*math.pi**4*N*k_B*(T/Theta)**3", "values": {"N": 1.0, "k_B": 1.380649e-23, "T": 10.0, "Theta": 1000.0}, "expected_symbols": ["C_p", "N", "k_B", "T", "Theta"], "note": "Debye low-temperature limit; exponent 3 must stay on (T/Theta)", "expected_value": 3.2277063390481063e-27}
{"id": "ideal-gas-pressure", "latex": "p=\\frac{n R T}{V}", "independent_expr": "n*R*T/V", "values": {"n": 1.0, "R": 8.314462618, "T": 300.0, "V": 0.024}, "expected_symbols": ["p", "n", "R", "T", "V"], "note": "nested fraction; every symbol appears once", "expected_value": 103930.78272500001}
{"id": "arrhenius-rate", "latex": "k=A\\exp(-\\frac{E_a}{R T})", "independent_expr": "A*math.exp(-E_a/(R*T))", "values": {"A": 10000000000000.0, "E_a": 50000.0, "R": 8.314462618, "T": 300.0}, "expected_symbols": ["k", "A", "E_a", "R", "T"], "note": "minus sign inside the exponential and a subscripted activation energy", "expected_value": 19696.844050928685}
{"id": "einstein-heat-capacity", "latex": "C=3Nk_B(\\frac{\\Theta}{T})^2\\frac{\\exp(\\Theta/T)}{(\\exp(\\Theta/T)-1)^2}", "independent_expr": "3*N*k_B*(Theta/T)**2*math.exp(Theta/T)/(math.exp(Theta/T)-1)**2", "values": {"N": 1.0, "k_B": 1.380649e-23, "T": 300.0, "Theta": 300.0}, "expected_symbols": ["C", "N", "k_B", "Theta", "T"], "note": "powers on a bracketed ratio plus a squared denominator", "expected_value": 3.813381231508183e-23}
{"id": "debye-length", "latex": "\\lambda_D=\\sqrt{\\frac{\\epsilon_0 k_B T}{n e^2}}", "independent_expr": "math.sqrt(epsilon_0*k_B*T/(n*e**2))", "values": {"epsilon_0": 8.8541878128e-12, "k_B": 1.380649e-23, "T": 300.0, "n": 1e+20, "e": 1.602176634e-19}, "expected_symbols": ["lambda_D", "epsilon_0", "k_B", "T", "n", "e"], "note": "square root of a fraction; charge appears squared", "expected_value": 1.1952706071189928e-07}
{"id": "fermi-energy", "latex": "E_F=\\frac{\\hbar^2}{2m}(3\\pi^2 n)^{2/3}", "independent_expr": "hbar**2/(2*m)*(3*math.pi**2*n)**(2/3)", "values": {"hbar": 1.054571817e-34, "m": 9.1093837015e-31, "n": 8.47e+28}, "expected_symbols": ["E_F", "hbar", "m", "n"], "note": "fractional exponent 2/3 on a bracketed product", "expected_value": 1.1267725818968546e-18}
{"id": "larmor-frequency", "latex": "\\omega=\\gamma B", "independent_expr": "gamma*B", "values": {"gamma": 267522128.0, "B": 1.5}, "expected_symbols": ["omega", "gamma", "B"], "note": "implicit product of two symbols; Greek letter must survive", "expected_value": 401283192.0}
{"id": "diffusion-length", "latex": "L=\\sqrt{D \\tau}", "independent_expr": "math.sqrt(D*tau)", "values": {"D": 1e-09, "tau": 0.001}, "expected_symbols": ["L", "D", "tau"], "note": "square root of a product; no numeric coefficient", "expected_value": 1.0000000000000002e-06}
{"id": "stefan-boltzmann-flux", "latex": "j=\\sigma T^4", "independent_expr": "sigma*T**4", "values": {"sigma": 5.670374419e-08, "T": 300.0}, "expected_symbols": ["j", "sigma", "T"], "note": "single-power term; catches a dropped exponent", "expected_value": 459.300327939}
{"id": "thermal-de-broglie", "latex": "\\lambda=\\frac{h}{\\sqrt{2\\pi m k_B T}}", "independent_expr": "h/math.sqrt(2*math.pi*m*k_B*T)", "values": {"h": 6.62607015e-34, "m": 1.67262192369e-27, "k_B": 1.380649e-23, "T": 300.0}, "expected_symbols": ["lambda", "h", "m", "k_B", "T"], "note": "square root in the denominator; constants under the root", "expected_value": 1.0043034025695798e-10}
